<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GuardPrototype.ForgotPasswordPage"
             Title="Reset Password">

    <!-- Gradient Background -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#000000" Offset="0.0"/>
            <GradientStop Color="#0A84FF" Offset="1.0"/>
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">

            <!-- Title -->
            <Label Text="Reset Your Password"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Margin="0,0,0,20"/>

            <!-- Step 1: Username input -->
            <Label Text="Step 1: Enter your Username" 
                   FontAttributes="Bold"
                   TextColor="#0A84FF"/>
            <Frame CornerRadius="12" Padding="10" BackgroundColor="#1A1A1A">
                <Entry x:Name="UsernameEntry"
                       Placeholder="Enter your Username"
                       PlaceholderColor="#9AA0A6"
                       TextColor="White"
                       BackgroundColor="Transparent"
                       ClearButtonVisibility="WhileEditing"/>
            </Frame>

            <!-- Verify Username Button -->
            <Button x:Name="VerifyUsernameButton"
                    Text="Verify Username"
                    BackgroundColor="Black"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="45"
                    Clicked="OnUsernameVerified"/>

            <!-- Step 2: Rooms input (hidden initially) -->
            <Label Text="Step 2: Enter your Total Rooms" 
                   FontAttributes="Bold"
                   TextColor="#0A84FF"
                   IsVisible="False"
                   x:Name="RoomsLabel"/>
            <Frame CornerRadius="12" Padding="10" BackgroundColor="#1A1A1A" IsVisible="False">
                <Entry x:Name="RoomsEntry"
                       Placeholder="Enter total rooms"
                       PlaceholderColor="#9AA0A6"
                       TextColor="White"
                       BackgroundColor="Transparent"
                       Keyboard="Numeric"
                       ClearButtonVisibility="WhileEditing"/>
            </Frame>

            <Button x:Name="VerifyRoomsButton"
                    Text="Verify Rooms"
                    BackgroundColor="Black"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="45"
                    Clicked="OnVerifyRoomsClicked"
                    IsVisible="False"/>

            <!-- Step 3: New password (hidden initially) -->
            <Label Text="Step 3: Set new password" 
                   FontAttributes="Bold"
                   TextColor="#0A84FF"
                   IsVisible="False"
                   x:Name="PasswordLabel"/>
            <Frame CornerRadius="12" Padding="10" BackgroundColor="#1A1A1A" IsVisible="False">
                <Entry x:Name="NewPasswordEntry"
                       Placeholder="New Password"
                       PlaceholderColor="#9AA0A6"
                       TextColor="White"
                       BackgroundColor="Transparent"
                       IsPassword="True"
                       ClearButtonVisibility="WhileEditing"/>
            </Frame>

            <Frame CornerRadius="12" Padding="10" BackgroundColor="#1A1A1A" IsVisible="False">
                <Entry x:Name="ConfirmPasswordEntry"
                       Placeholder="Confirm Password"
                       PlaceholderColor="#9AA0A6"
                       TextColor="White"
                       BackgroundColor="Transparent"
                       IsPassword="True"
                       ClearButtonVisibility="WhileEditing"/>
            </Frame>

            <Button x:Name="ChangePasswordButton"
                    Text="Change Password"
                    BackgroundColor="#0A84FF"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="50"
                    Clicked="OnChangePasswordClicked"
                    IsVisible="False"/>

            <!-- Back button -->
            <Button Text="Back to Login"
                    BackgroundColor="Transparent"
                    TextColor="#0A84FF"
                    FontAttributes="Bold"
                    CornerRadius="20"
                    HeightRequest="45"
                    Clicked="OnBackClicked"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
