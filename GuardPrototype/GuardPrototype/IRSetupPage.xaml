<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="GuardPrototype.IRSetupPage"
             Title="IR Setup"
             Background="Transparent">

    <!-- Gradient Background -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#000000" Offset="0.0"/>
            <!-- Black -->
            <GradientStop Color="#0A84FF" Offset="1.0"/>
            <!-- Futuristic Blue -->
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20">

            <!-- Section: Discovered Devices -->
            <Label Text="Discovered RM3 Devices"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="0,0,0,10"/>

            <CollectionView x:Name="DeviceListView" ItemsSource="{Binding}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BackgroundColor="#1A1A1A"
                               CornerRadius="12"
                               Padding="10"
                               Margin="0,5,0,5"
                               HasShadow="True">
                            <StackLayout>
                                <Label Text="{Binding name}" 
                                       FontAttributes="Bold" 
                                       TextColor="White"/>
                                <Label Text="{Binding mac}" 
                                       FontSize="12" 
                                       TextColor="#9AA0A6"/>
                                <Label Text="{Binding type}" 
                                       FontSize="12" 
                                       TextColor="#9AA0A6"/>
                            </StackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Refresh Button -->
            <Button Text="Refresh Devices"
                    Clicked="OnDiscoverClicked"
                    BackgroundColor="#0A84FF"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="45"
                    Shadow="5"/>

            <!-- Section: Register Appliance -->
            <Label Text="Register IR Appliance"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Center"
                   Margin="0,20,0,10"/>

            <!-- Device Name -->
            <Frame CornerRadius="12" Padding="10" BackgroundColor="#1A1A1A">
                <Entry x:Name="DeviceNameEntry"
                       Placeholder="Device Name (e.g., TV)"
                       PlaceholderColor="#9AA0A6"
                       TextColor="White"
                       BackgroundColor="Transparent"/>
            </Frame>

            <!-- Device Type -->
            <Frame CornerRadius="12" Padding="10" BackgroundColor="#1A1A1A">
                <Entry x:Name="DeviceTypeEntry"
                       Placeholder="Device Type (e.g., AC)"
                       PlaceholderColor="#9AA0A6"
                       TextColor="White"
                       BackgroundColor="Transparent"/>
            </Frame>

            <!-- RM3 IP Address -->
            <Frame CornerRadius="12" Padding="10" BackgroundColor="#1A1A1A">
                <Entry x:Name="RM3IpEntry"
                       Placeholder="RM3 IP Address"
                       PlaceholderColor="#9AA0A6"
                       TextColor="White"
                       BackgroundColor="Transparent"/>
            </Frame>

            <!-- Command Hex Code -->
            <Frame CornerRadius="12" Padding="10" BackgroundColor="#1A1A1A">
                <Entry x:Name="CommandHexEntry"
                       Placeholder="Command Hex Code"
                       PlaceholderColor="#9AA0A6"
                       TextColor="White"
                       BackgroundColor="Transparent"/>
            </Frame>

            <!-- Register Button -->
            <Button Text="Register Appliance"
                    Clicked="OnRegisterClicked"
                    BackgroundColor="#0A84FF"
                    TextColor="White"
                    CornerRadius="20"
                    FontAttributes="Bold"
                    HeightRequest="50"
                    Shadow="5"
                    Margin="0,20,0,0"/>

            <!-- Status Label -->
            <Label x:Name="StatusLabel"
                   Text=""
                   TextColor="#00FF9D" 
                   FontAttributes="Italic"
                   HorizontalOptions="Center"
                   Margin="0,10,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
