<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="GuardPrototype.DeviceSetupGuidePage"
             Title="Device Setup Guide"
             Background="Transparent">

    <!-- Gradient Background -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#000000" Offset="0.0"/>
            <!-- Black -->
            <GradientStop Color="#0A84FF" Offset="1.0"/>
            <!-- Futuristic Neon Blue -->
        </LinearGradientBrush>
    </ContentPage.Background>

    <ScrollView>
        <VerticalStackLayout Spacing="20" Padding="20">

            <!-- Title -->
            <Label Text="Guard App Device Setup Guide" 
                   FontSize="30" 
                   FontAttributes="Bold" 
                   HorizontalOptions="Center" 
                   TextColor="White"
                   Margin="0,0,0,20"/>

            <!-- Tuya Smart Plugs -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Label Text="1. Tuya Smart Plugs" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="#0A84FF"/>
                    <!-- Neon Blue -->
                </toolkit:Expander.Header>
                <toolkit:Expander.Content>
                    <VerticalStackLayout Spacing="5" Padding="10">
                        <Label Text="• Follow the Tuya app instructions to connect the plug to Wi-Fi." TextColor="White"/>
                        <Label Text="• Create a Tuya Developer Account at https://iot.tuya.com and create a Cloud Project. Link your account." TextColor="White"/>
                        <Label Text="• Copy Device ID, Access ID, and Access Secret from your Cloud Project and enter them in Guard App." TextColor="White"/>
                    </VerticalStackLayout>
                </toolkit:Expander.Content>
            </toolkit:Expander>

            <!-- Shelly PM Mini -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Label Text="2. Shelly PM Mini" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="#0A84FF"/>
                </toolkit:Expander.Header>
                <toolkit:Expander.Content>
                    <VerticalStackLayout Spacing="5" Padding="10">
                        <Label Text="• Install PM Mini in your socket and connect via Shelly Cloud app." TextColor="White"/>
                        <Label Text="• Note the assigned IP address of the device." TextColor="White"/>
                        <Label Text="• Enter Device IP in Guard App and test on/off control." TextColor="White"/>
                    </VerticalStackLayout>
                </toolkit:Expander.Content>
            </toolkit:Expander>

            <!-- Shelly Flood Sensor -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Label Text="3. Shelly Flood Sensor" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="#0A84FF"/>
                </toolkit:Expander.Header>
                <toolkit:Expander.Content>
                    <VerticalStackLayout Spacing="5" Padding="10">
                        <Label Text="• Place the sensor and connect via Shelly Cloud app." TextColor="White"/>
                        <Label Text="• Note the IP address." TextColor="White"/>
                        <Label Text="• Enter Device IP in Guard App and verify status." TextColor="White"/>
                    </VerticalStackLayout>
                </toolkit:Expander.Content>
            </toolkit:Expander>

            <!-- RM3 Blaster -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Label Text="4. RM3 Blaster (IR Control)" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="#0A84FF"/>
                </toolkit:Expander.Header>
                <toolkit:Expander.Content>
                    <VerticalStackLayout Spacing="5" Padding="10">
                        <Label Text="• Plug in RM3 and connect via manufacturer app." TextColor="White"/>
                        <Label Text="• Note Device Name, IP address, and IR command hex codes." TextColor="White"/>
                        <Label Text="• Enter Device Name, Type, IP, and Command Hex in Guard App. Test each appliance." TextColor="White"/>
                    </VerticalStackLayout>
                </toolkit:Expander.Content>
            </toolkit:Expander>

            <!-- Camera -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Label Text="5. Camera (IP / Hikvision)" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="#0A84FF"/>
                </toolkit:Expander.Header>
                <toolkit:Expander.Content>
                    <VerticalStackLayout Spacing="5" Padding="10">
                        <Label Text="• Connect camera to network and set username/password." TextColor="White"/>
                        <Label Text="• Note IP address, username, and password. Test login." TextColor="White"/>
                        <Label Text="• Enter IP, username, and password in Guard App. Verify live feed." TextColor="White"/>
                    </VerticalStackLayout>
                </toolkit:Expander.Content>
            </toolkit:Expander>

            <!-- Air Quality Sensor -->
            <toolkit:Expander>
                <toolkit:Expander.Header>
                    <Label Text="6. Air Quality Sensor" 
                           FontSize="22" 
                           FontAttributes="Bold" 
                           TextColor="#0A84FF"/>
                </toolkit:Expander.Header>
                <toolkit:Expander.Content>
                    <VerticalStackLayout Spacing="5" Padding="10">
                        <Label Text="• Connect sensor to power and Wi-Fi using official instructions." TextColor="White"/>
                        <Label Text="• Note Device ID and API key from the app or portal." TextColor="White"/>
                        <Label Text="• Enter API key and Device ID in Guard App. Confirm readings appear." TextColor="White"/>
                    </VerticalStackLayout>
                </toolkit:Expander.Content>
            </toolkit:Expander>

            <!-- Tips -->
            <Label Text="Tips for All Devices" 
                   FontSize="22" 
                   FontAttributes="Bold" 
                   TextColor="#0A84FF"
                   Margin="0,20,0,10"/>
            <Label Text="• Test each device in its original app before linking to Guard App." TextColor="White"/>
            <Label Text="• Double-check IPs, usernames, passwords, and API keys." TextColor="White"/>
            <Label Text="• Keep developer keys and credentials private." TextColor="White"/>
            <Label Text="• For Tuya, always select the correct region in the cloud project." TextColor="White"/>

            <Label Text="For more help, ask ChatGPT to guide you step by step!" 
                   FontAttributes="Bold" 
                   TextColor="#0A84FF" 
                   HorizontalOptions="Center"
                   Margin="0,10,0,0"/>

            <!-- Exit Button -->
            <Button Text="Exit" 
                    BackgroundColor="#0A84FF" 
                    TextColor="White" 
                    CornerRadius="20" 
                    HeightRequest="50"
                    Shadow="5"
                    Margin="0,20,0,0"
                    Clicked="OnExitClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
